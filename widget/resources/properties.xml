<resources>
    <properties>
        <property id="secret" type="string"></property>
        <property id="scenes" type="string"></property>
        <property id="refresh" type="boolean">false</property>
        <property id="reportBattery" type="boolean">true</property>
        <property id="closeAfterAction" type="boolean">false</property>
        <property id="autoCloseSeconds" type="number">0</property>
        <property id="useListView" type="boolean">false</property>
        <property id="coloredIcons" type="boolean">false</property>
    </properties>

    <strings>
       <string id="secret_title">Shared secret (32 hex digits, shown when adding the Garmin BLE integration in Home Assistant)</string>
       <string id="scenes_title">Scene name overrides: (scene1=Name,scene2)</string>
       <string id="refresh_title">Refresh on show</string>
       <string id="reportBattery_title">Report watch battery to Home Assistant</string>
       <string id="closeAfterAction_title">Close App after successful action</string>
       <string id="autoCloseSeconds_title">Auto-close after inactivity (seconds, 0=off)</string>
       <string id="useListView_title">Use list view style (3-row list instead of classic card)</string>
       <string id="coloredIcons_title">Colored icons (Home Assistant state colors)</string>
    </strings>

    <settings>
        <setting propertyKey="@Properties.secret" title="@Strings.secret_title">
            <settingConfig type="alphaNumeric" />
        </setting>
        <setting propertyKey="@Properties.scenes" title="@Strings.scenes_title">
            <settingConfig type="alphaNumeric" />
        </setting>
        <setting propertyKey="@Properties.refresh" title="@Strings.refresh_title">
            <settingConfig type="boolean" />
        </setting>
        <setting propertyKey="@Properties.reportBattery" title="@Strings.reportBattery_title">
            <settingConfig type="boolean" />
        </setting>
        <setting propertyKey="@Properties.closeAfterAction" title="@Strings.closeAfterAction_title">
            <settingConfig type="boolean" />
        </setting>
        <setting propertyKey="@Properties.autoCloseSeconds" title="@Strings.autoCloseSeconds_title">
            <settingConfig type="numeric" min="0" max="300" />
        </setting>
        <setting propertyKey="@Properties.useListView" title="@Strings.useListView_title">
            <settingConfig type="boolean" />
        </setting>
        <setting propertyKey="@Properties.coloredIcons" title="@Strings.coloredIcons_title">
            <settingConfig type="boolean" />
        </setting>
    </settings>
</resources>
